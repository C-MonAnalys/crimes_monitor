{
  "name": "crimes-stance-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run config && ng serve",
    "build": "npm run config && ng build",
    "build:ghpages": "npm run config && ng build --configuration production --base-href /crimes_monitor/ && npx angular-cli-ghpages --dir=dist/crimes-stance-web/browser --branch=gh-pages",
    "config": "node scripts/set-env.js",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.2.0",
    "@angular/compiler": "^20.2.0",
    "@angular/core": "^20.2.0",
    "@angular/forms": "^20.2.0",
    "@angular/platform-browser": "^20.2.0",
    "@angular/platform-browser-dynamic": "^20.2.0",
    "@angular/router": "^20.2.0",
    "@primeuix/themes": "^1.2.3",
    "bootstrap-icons": "^1.13.1",
    "chartjs-plugin-zoom": "^2.2.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.3",
    "ng2-charts": "^8.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "optionalDependencies": {
    "chart.js": "^4.5.0",
    "primeicons": "^7.0.0",
    "primeng": "^20.1.1"
  },
  "devDependencies": {
    "@angular/build": "^20.2.2",
    "@angular/cli": "^20.2.2",
    "@angular/compiler-cli": "^20.2.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/dotenv": "^6.1.1",
    "@types/html2canvas": "^0.5.35",
    "@types/jasmine": "~5.1.0",
    "@types/jspdf": "^1.3.3",
    "@types/node": "^25.5.0",
    "angular-cli-ghpages": "^2.0.3",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.3.1",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.13",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2"
  }
}
